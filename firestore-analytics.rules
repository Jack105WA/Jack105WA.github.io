// Analytics rules for the GitHub Pages site.
// Merge this match block into the existing Firestore rules.
// Do not replace your existing rules with this file: blog/admin permissions
// must remain in the main firestore.rules file.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /siteStats/counters {
      // The public site can read the counter.
      allow get: if true;
      allow list: if false;

      // Create the document manually in Firestore with: { hits: 0 }
      allow create, delete: if false;

      // A public request may change only "hits", and only increase it by 1.
      allow update: if
        resource.data.keys().hasOnly(['hits']) &&
        request.resource.data.keys().hasOnly(['hits']) &&
        resource.data.hits is int &&
        request.resource.data.hits is int &&
        request.resource.data.hits == resource.data.hits + 1;
    }
  }
}
